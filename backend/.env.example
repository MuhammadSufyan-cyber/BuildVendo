# Copy to .env and fill in. Never commit .env.

# --- Database (MongoDB Atlas) ---
# Atlas -> Connect -> Drivers. Replace <password>. Leave empty only for a throwaway local test database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=ecommerce_platform

# --- First start on a real server: your Super Admin (used only if no Super Admin exists yet) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Server ---
PORT=5000
# The public address of the WEBSITE (frontend). Used in emailed links and for CORS.
FRONTEND_URL=http://localhost:3000
# Set to "production" when deployed: hides development helpers, makes cookies Secure, requires real payments flow.
NODE_ENV=development
# The platform's own domain. Stores can use <store-id>.ROOT_DOMAIN. Use "localhost" for development.
ROOT_DOMAIN=localhost

# --- Secrets: generate long random values (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
JWT_SECRET=
PASSWORD_PEPPER=
# Encrypts stored secrets such as a store's Stripe key. If empty, derived from JWT_SECRET.
ENCRYPTION_KEY=

# --- Security ---
# 1 = platform staff must set up two-factor login (recommended in production)
REQUIRE_2FA_PLATFORM=0

# --- Email (without SMTP_HOST, emails are printed in the console instead) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BuildVendo <no-reply@yourdomain.com>

# --- Stripe: the platform's own account, used to charge stores for their package ---
STRIPE_SECRET_KEY=
# Stripe -> Developers -> Webhooks -> endpoint https://YOUR-BACKEND/api/webhooks/stripe
# events: checkout.session.completed, customer.subscription.deleted, invoice.payment_failed, invoice.paid
STRIPE_WEBHOOK_SECRET=

# --- AI Store Builder (without a key an offline keyword generator is used) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
