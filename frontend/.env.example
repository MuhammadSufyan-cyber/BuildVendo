# Copy to .env.local. On Vercel set these in Project Settings -> Environment Variables.

# Where the backend API runs (the browser never talks to it directly; Next forwards /api and /uploads).
BACKEND_URL=http://localhost:5000

# The platform's own domain. Hosts like <store-id>.ROOT_DOMAIN and verified custom domains open that store's shop.
# Use "localhost" in development (try http://demo.localhost:3000).
ROOT_DOMAIN=localhost
